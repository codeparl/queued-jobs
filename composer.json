{
    "name": "schoolpalm/queued-jobs",
    "description": "A Laravel queue infrastructure package that preserves application execution context when dispatching queued jobs.",
    "type": "library",
    "license": "MIT",
    "version": "1.2.0",
    "authors": [
        {
            "name": "SchoolPalm",
            "email": "dev@schoolpalm.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^12.0|^11.0",
        "illuminate/support": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/cache": "^12.0|^11.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "SchoolPalm\\QueuedJobs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SchoolPalm\\QueuedJobs\\Tests\\": "tests/",
            "Tests\\Fixtures\\": "tests/Fixtures/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SchoolPalm\\QueuedJobs\\Providers\\QueuedJobsServiceProvider"
            ],
            "aliases": {
                "QueuedJobs": "SchoolPalm\\QueuedJobs\\Facades\\QueuedJobs"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/pest"
        ]
    }
}