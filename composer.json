{
    "name": "schoolpalm/queued-jobs",
    "description": "A Laravel queue infrastructure package that preserves application execution context when dispatching queued jobs.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "SchoolPalm",
            "email": "dev@schoolpalm.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/queue": "^10.0|^11.0",
        "illuminate/cache": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0",
        "laravel/pint": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "SchoolPalm\\QueuedJobs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SchoolPalm\\QueuedJobs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SchoolPalm\\QueuedJobs\\Providers\\QueuedJobsServiceProvider"
            ],
            "aliases": {
                "QueuedJobs": "SchoolPalm\\QueuedJobs\\Facades\\QueuedJobs"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

